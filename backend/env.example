# Database Configuration
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/consultorio_db
SYNC_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/consultorio_db

# JWT Configuration
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# App Configuration
APP_NAME=denti-backend
API_PREFIX=/v1
LOG_LEVEL=INFO
ENABLE_GZIP=true
