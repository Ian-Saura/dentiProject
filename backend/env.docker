# Database Configuration for Docker
DATABASE_URL=mysql+asyncmy://denti_user:denti_pass@mysql:3306/consultorio_db
SYNC_DATABASE_URL=mysql+pymysql://denti_user:denti_pass@mysql:3306/consultorio_db

# JWT Configuration
JWT_SECRET_KEY=dentiproject-production-secret-key-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# App Configuration
APP_NAME=DentiProject Backend
API_PREFIX=/v1
LOG_LEVEL=INFO
ENABLE_GZIP=true

