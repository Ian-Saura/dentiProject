# DentiProject Production Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=consultorio_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/consultorio_db

# JWT Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_NAME=DentiProject
APP_VERSION=2.0.0
DEBUG=False

# CORS Configuration (for production, specify exact origins)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Currency Configuration
DEFAULT_CURRENCY=ARS
USD_TO_ARS_RATE=1335.0

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/dentiproject.log
