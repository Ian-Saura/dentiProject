# DentiProject Docker Environment Configuration

# Database Configuration
DATABASE_URL=mysql+pymysql://denti_user:denti_pass@mysql:3306/consultorio_db

# JWT Security
JWT_SECRET_KEY=super-secret-production-jwt-key-change-this-in-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Configuration
APP_NAME=DentiProject
APP_VERSION=2.0.0
DEBUG=False

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost,http://frontend:3000

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Currency Configuration
DEFAULT_CURRENCY=ARS
USD_TO_ARS_RATE=1335.0
